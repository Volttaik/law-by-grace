# ── THE LAW With Gracious · environment variables ────────────────────────────────
# Copy to .env (local) or into Vercel Project → Settings → Environment
# Variables. Only the keys below are actually read by THE LAW With Gracious
# codebase. Values marked (shared) are reused from the shared Turso /
# Cloudflare / Resend accounts also used by the other project; values
# marked (own) must be THE LAW With Gracious specific.

# ── Turso (database) ────────────────────────────────────────────────────
# Shared Turso database (other project's tables live alongside ours under
# the law_by_grace_* namespace — never altered).
TURSO_DATABASE_URL="libsql://..."        # (shared)
TURSO_AUTH_TOKEN="..."                   # (shared)

# ── Cloudflare R2 (media storage) ───────────────────────────────────────
# Shared Cloudflare account/bucket is fine: THE LAW With Gracious always writes
# under the "law-by-grace/" key prefix, so objects never collide.
R2_ENDPOINT="https://<accountid>.r2.cloudflarestorage.com"   # (shared)
R2_ACCESS_KEY_ID="..."                    # (shared)
R2_SECRET_ACCESS_KEY="..."                # (shared)
R2_BUCKET_NAME="lobbymarket"              # (shared bucket — prefixed keys)
R2_REGION="auto"

# ── Resend (transactional email) ────────────────────────────────────────
# THE LAW With Gracious uses its own Resend API key (server-side only). It is never
# exposed to the client. The sender is ALWAYS branded "THE LAW With Gracious" by
# src/lib/email.ts — only the address below is read from the environment.
RESEND_API_KEY="re_..."
# From address — MUST be a domain verified in the Resend account that owns
# the key above. lawbygrace.app is THE LAW With Gracious target domain; until it
# is verified in Resend, keep the currently verified sending domain and
# always keep the "THE LAW With Gracious" display name.
EMAIL_FROM="THE LAW With Gracious <no-reply@quizmi.space>"

# ── Authentication (REQUIRED) ───────────────────────────────────────────
# NextAuth v5 requires this in production. Generate your own, e.g.
#   openssl rand -base64 32
AUTH_SECRET="generate-a-long-random-string"

# ── Admin bootstrap (only needed for `pnpm db:admin` on a fresh DB) ────
LAW_BY_GRACE_ADMIN_EMAIL="admin@lawbygrace.com"
LAW_BY_GRACE_ADMIN_PASSWORD="choose-a-strong-password"
LAW_BY_GRACE_ADMIN_NAME="Grace"

# ── Optional ────────────────────────────────────────────────────────────
# Used only as a base-URL fallback for share/generateMetadata links when
# no request origin is available (e.g. local tooling). Set to the Law by
# Grace domain. NOT the other project's domain.
# NEXTAUTH_URL="https://your-law-by-grace-domain.com"
# AUTH_URL="https://your-law-by-grace-domain.com"
